{
  "name": "grants-platform-dal-stub",
  "version": "0.0.0",
  "description": "Synthetic-data stub of the FCP Data Access Layer (DAL) GraphQL API for the grants platform",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "AWS_EMF_ENVIRONMENT=Local NODE_ENV=development npm run server:watch",
    "dev:debug": "AWS_EMF_ENVIRONMENT=Local NODE_ENV=development npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm run check:fixtures && npm test",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js,mjs}\"",
    "lint:fix": "npm run lint -- --fix",
    "check:fixtures": "node scripts/check-fixtures.js",
    "schema:check": "node scripts/sync-upstream-schema.js --check",
    "schema:sync": "node scripts/sync-upstream-schema.js",
    "security-audit": "npm audit --audit-level=critical",
    "server:debug": "node --watch --inspect-brk=0.0.0.0 --env-file-if-exists=.env ./src",
    "server:watch": "node --watch --inspect=0.0.0.0 --env-file-if-exists=.env ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node . --env-file-if-exists=.env",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/hapi": "2.0.2",
    "@defra/cdp-auditing": "0.6.2",
    "@defra/cdp-metrics": "0.6.1",
    "@defra/hapi-secure-context": "0.4.1",
    "@defra/hapi-tracing": "1.30.1",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.11",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "graphql": "16.14.2",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "joi": "18.3.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "neostandard": "0.14.1",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.10",
    "vitest": "5.0.5"
  }
}
